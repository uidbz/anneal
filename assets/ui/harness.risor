// Anneal harness pane — embedded as a fynerisor CanvasObject inside the Go
// shell. Pull-based by design: the pane refreshes after each action; live
// improve/review events are rendered by the Go transcript.
//
// Risor v2 constraints: no loops, no ternary, if conditions need parentheses,
// else must hug the closing brace, arrays concatenate with +, and closures see
// free variables at compile time (placeholders first).
require(["v0.9", "@gui", "@json"])

let label = (text) => {
    let l = widget.NewLabel(text)
    l.Wrapping = constants.TextWrapBreak
    return l
}

let short = (s, n) => {
    if (len(s) <= n) { return s }
    return s[0:n] + "…"
}

let msg = ""
let pendingPromote = ""
let openExp = ""
let notice = label("")
let build = () => {}
let refresh = () => { build() }

let compText = (arr, i, acc) => acc
compText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let c = arr[i]
    return compText(arr, i + 1, acc + " " + c.name + "(" + sprintf("%d", c.chars) + ")")
}

let warnText = (arr, i, acc) => acc
warnText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    return warnText(arr, i + 1, acc + "\n  warn: " + arr[i])
}

let fileRows = (files, i, acc) => acc
fileRows = (files, i, acc) => {
    if (i >= len(files)) { return acc }
    let name = files[i]
    let got = agent.harnessGet(name)
    if (got.error != "") {
        return fileRows(files, i + 1, acc + [label("⚠ " + name + ": " + got.error)])
    }
    let ed = widget.NewMultiLineEntry()
    ed.Text = got.content
    let row = container.NewVBox([
        label("— " + name + " —"),
        ed,
        container.NewHBox([widget.NewButton("save " + name, () => {
            let r = agent.harnessSave(name, ed.Text)
            if (r.error != "") {
                msg = "save " + name + " failed: " + r.error
            } else {
                msg = "saved " + name + " (prose next run; rule lines need restart)"
            }
            if (r.warns != []) { msg = msg + " | warn: " + r.warns[0] }
            refresh()
        })])
    ])
    return fileRows(files, i + 1, acc + [row])
}

let libRows = (arr, i, acc) => acc
libRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let e = arr[i]
    let eid = e.id
    let plabel = "promote"
    if (pendingPromote == eid) { plabel = "promote — sure? click again" }
    let row = container.NewVBox([
        label(eid + " — " + e.situation),
        container.NewHBox([
            widget.NewButton("experience", () => {
                if (openExp == eid) { openExp = "" } else { openExp = eid }
                refresh()
            }),
            widget.NewButton(plabel, () => {
                if (pendingPromote == eid) {
                    let r = agent.libPromote(eid)
                    pendingPromote = ""
                    if (r.error != "") {
                        msg = "promote failed: " + r.error
                    } else {
                        msg = "promoted " + eid
                        if (r.backup != "") { msg = msg + " — backup: " + r.backup }
                        msg = msg + " (restart to re-read rules)"
                    }
                } else {
                    pendingPromote = eid
                }
                refresh()
            })
        ])
    ])
    return libRows(arr, i + 1, acc + [row])
}

let flagRows = (arr, i, acc) => acc
flagRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    return flagRows(arr, i + 1, acc + [label("🪧 " + arr[i].gap)])
}

build = () => {
    let h = json.parse(agent.harnessInfo())
    let files = json.parse(agent.harnessFiles())
    let lb = json.parse(agent.harnessLibList())
    let fl = json.parse(agent.flagPeek(8))

    let en = ""
    if (h.enabled == false) { en = "  (DISABLED)" }
    let cs = compText(h.components, 0, "")
    if (cs == "") { cs = " none (base harness)" }
    let r = h.rules
    let rows = [
        label("Harness — " + h.root + en),
        label("components:" + cs),
        label("guardrail rules: allow=" + sprintf("%d", len(r.allow)) + "  ask=" + sprintf("%d", len(r.ask)) + "  deny=" + sprintf("%d", len(r.deny))),
        label("prose edits apply next run; edit guardrails.md rule lines then restart Anneal"),
        container.NewHBox([
            widget.NewButton("refresh", () => { refresh() }),
            widget.NewButton("improve last task", () => {
                agent.improveStart()
                msg = "harness improvement started — watch the chat transcript"
                refresh()
            })
        ])
    ]
    rows = rows + fileRows(files, 0, [])
    if (h.warnings != []) { rows = rows + [label("⚠" + warnText(h.warnings, 0, ""))] }
    let lt = "none yet — evidence-backed improve steps create entries"
    if (lb != []) { lt = sprintf("%d entries — promote is the only route into the global harness", len(lb)) }
    rows = rows + [label("improvement library: " + lt)]
    rows = rows + libRows(lb, 0, [])
    if (fl != []) {
        rows = rows + [label("reviewer flags (the next /improve consumes these as hints):")]
        rows = rows + flagRows(fl, 0, [])
    }
    if (openExp != "") {
        let ex = json.parse(agent.libExperience(openExp))
        if (ex.error != "") {
            rows = rows + [label("⚠ experience: " + ex.error)]
        } else {
            rows = rows + [label("### experience — " + openExp), label(ex.content)]
        }
    }
    if (msg != "") { rows = rows + [label(msg)] }
    rows = rows + [notice]
    window.SetContent(container.NewScroll(container.NewVBox(rows)))
}

// Narrow live feed from the Go shell (harness/improve lifecycle only). We
// update a label instead of rebuilding, so unsaved editor text is not lost.
agent.on((evtJson) => {
    let e = json.parse(evtJson)
    let t = e.type
    if (t == "harness.promoted") { notice.Text = "✔ promoted — restart for rule lines; click refresh" }
    if (t == "harness.warn") { notice.Text = "⚠ harness files changed — click refresh" }
    if (t == "harness.warning") { notice.Text = "⚠ " + e.message }
    if (t == "improve.done") { notice.Text = "🔧 improve finished — click refresh" }
    if (t == "improve.library") { notice.Text = "🔧 library entry updated — click refresh" }
    if (t == "improve.error") { notice.Text = "⚠ improve: " + e.error }
    if (t == "review.flag") { notice.Text = "🪧 reviewer flagged a gap — refresh to see it" }
    if (t == "config.changed") { notice.Text = "⚙ configuration changed" }
})

build()
print("HARNESS-PANE-READY")
