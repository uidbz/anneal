// fyagent UI — M3: sessions, permission approval inbox, plan/build modes,
// todo panel, plus M2 chat (transcript, streaming, tool cards, usage).
// Risor v2 constraints (see fynerisor skill): no for/while, no map/filter,
// no ternary, if (cond) needs parens, missing map keys error on dot-access,
// keyword keys (in/out) break dot-access, free vars resolve at compile time
// (placeholder-rebind for circular layouts; recursion via pre-declared slot).
// Containers have no Append — re-compose the layout on changes; widgets
// persist. Arrays support `+` concat; strings support [0:n] slices.
require(["v0.9", "@gui", "@json", "@strings"])

// ---------- state ----------
let widgets = []      // finalized transcript blocks
let tail = nil        // optional streaming tail (always visually last)
let tailBuf = ""
let mode = "default"
let sessOpen = false
let sessList = []     // {id,title,updated,events}
let permCards = []    // pending perm.request events
let memCards = []     // staged memory ops awaiting approval
let skillCards = []   // staged skill ops awaiting approval
let todos = []        // {content,status}
let sessID = ""
let viewMode = "chat" // "chat" | "harness"
let harnessRows = []  // cached harness-panel widgets (persist across compose)
let harnessDirty = true
let harnessMsg = ""   // one-line result of the last save/promote
let pendingPromote = "" // two-step promote confirmation
let openExp = ""      // library entry whose EXPERIENCE.md is shown

// ---------- helpers ----------
let md = (text) => {
    let m = widget.NewMarkdown(text)
    m.Wrapping = constants.TextWrapBreak
    return m
}

let label = (text) => {
    let l = widget.NewLabel(text)
    l.Wrapping = constants.TextWrapBreak
    return l
}

let short = (s, n) => {
    if (len(s) <= n) { return s }
    return s[0:n] + "…"
}

// recursive list builders (pre-declared slots so bodies can self-reference)
let sessBtns = (arr, i, acc) => acc
sessBtns = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let s = arr[i]
    let t = s.title
    if (t == "") { t = s.id }
    let b = widget.NewButton(short(t, 34), () => { agent.openSession(s.id) })
    return sessBtns(arr, i + 1, acc + [b])
}

let permRows = (arr, i, acc) => acc
permRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let c = arr[i]
    let info = label("🔐 " + c.tool + " — " + c.message + " [once | session: " + short(c.grant, 40) + "]\n" + strings.replace_all(c.input, "\n", " "))
    let row = container.NewBorder(nil, nil, nil, container.NewHBox([
        widget.NewButton("allow", () => { agent.respondPerm(c.id, "allow") }),
        widget.NewButton("session", () => { agent.respondPerm(c.id, "session") }),
        widget.NewButton("deny", () => { agent.respondPerm(c.id, "deny") }),
    ]), info)
    return permRows(arr, i + 1, acc + [row])
}

let opText = (c) => {
    if (c.action == "add") { return "+ " + c.content }
    if (c.action == "patch") { return short(c.old, 60) + "  →  " + short(c.new, 60) }
    return "- " + c.old
}

let memRows = (arr, i, acc) => acc
memRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let c = arr[i]
    let why = ""
    if (c.reason != "") { why = " (" + c.reason + ")" }
    let info = label("💾 memory[" + c.target + "] " + c.action + " via " + c.source + why + "\n" + strings.replace_all(opText(c), "\n", " "))
    let row = container.NewBorder(nil, nil, nil, container.NewHBox([
        widget.NewButton("approve", () => { agent.respondMemory(c.id, "approve") }),
        widget.NewButton("reject", () => { agent.respondMemory(c.id, "reject") }),
    ]), info)
    return memRows(arr, i + 1, acc + [row])
}

let skillPreview = (c) => {
    if (c.action == "create") { return "new skill " + c.name + " — " + c.description + "\n" + short(c.content, 300) }
    if (c.action == "patch") { return c.name + ": " + short(c.old, 60) + "  →  " + short(c.new, 60) }
    if (c.action == "write_file") { return c.name + ": write " + c.path + " (" + sprintf("%d", len(c.content)) + " chars)" }
    return "archive skill " + c.name
}

let skillRows = (arr, i, acc) => acc
skillRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let c = arr[i]
    let why = ""
    if (c.reason != "") { why = " (" + c.reason + ")" }
    let info = label("🛠 skill[" + c.action + "] " + c.name + " via " + c.source + why + "\n" + strings.replace_all(skillPreview(c), "\n", " "))
    let row = container.NewBorder(nil, nil, nil, container.NewHBox([
        widget.NewButton("approve", () => { agent.respondSkill(c.id, "approve") }),
        widget.NewButton("reject", () => { agent.respondSkill(c.id, "reject") }),
    ]), info)
    return skillRows(arr, i + 1, acc + [row])
}

let mcpText = (arr, i, nconn, ntools) => ""
mcpText = (arr, i, nconn, ntools) => {
    if (i >= len(arr)) {
        if (len(arr) == 0) { return "" }
        return "mcp: " + sprintf("%d/%d up, %d tools", nconn, len(arr), ntools)
    }
    let s = arr[i]
    let c = nconn
    if (s.connected) { c = nconn + 1 }
    return mcpText(arr, i + 1, c, ntools + s.tools)
}

let ledgerText = (arr, i, acc) => acc
ledgerText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let e = arr[i]
    let what = e.kind
    if (e.name != "") { what = what + " " + e.name }
    if (e.content != "") { what = what + " (" + short(e.content, 50) + ")" }
    return ledgerText(arr, i + 1, acc + "\n  • " + what + " [" + e.action + "] " + e.result)
}

let journeyText = (arr, i, acc) => acc
journeyText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let e = arr[i]
    return journeyText(arr, i + 1, acc + "\n" + e.ts + "  " + e.kind)
}

let harnessCompText = (arr, i, acc) => acc
harnessCompText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let c = arr[i]
    return harnessCompText(arr, i + 1, acc + " " + c.name + "(" + sprintf("%d", c.chars) + ")")
}
let harnessWarnText = (arr, i, acc) => acc
harnessWarnText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    return harnessWarnText(arr, i + 1, acc + "\n  warn: " + arr[i])
}

let keepCards = (arr, i, dropID, acc) => acc
keepCards = (arr, i, dropID, acc) => {
    if (i >= len(arr)) { return acc }
    if (arr[i].id != dropID) { return keepCards(arr, i + 1, dropID, acc + [arr[i]]) }
    return keepCards(arr, i + 1, dropID, acc)
}

let todoRows = (arr, i, acc) => acc
todoRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let it = arr[i]
    let g = "☐"
    if (it.status == "in_progress") { g = "▶" }
    if (it.status == "done") { g = "☑" }
    if (it.status == "cancelled") { g = "✖" }
    return todoRows(arr, i + 1, acc + [label(g + " " + short(it.content, 44))])
}

let blockFrom = (b) => {
    if (b.kind == "user") { return md("> " + b.text) }
    if (b.kind == "assistant") { return md(b.text) }
    if (b.kind == "tool") { return label("🔧 " + b.name + " " + strings.replace_all(b.input, "\n", " ")) }
    let mark = "✔"
    if (b.error) { mark = "✖" }
    if (b.name != "") { mark = mark + " " + b.name + ":" }
    return label("  " + mark + " " + strings.replace_all(b.text, "\n", " "))
}

let rebuild = (arr, i, acc) => acc
rebuild = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    return rebuild(arr, i + 1, acc + [blockFrom(arr[i])])
}

// ---------- widgets & layout ----------
let toggleSessions = () => {} // placeholder (compile-time capture)
let openHarness = () => {}   // placeholder
let buildHarness = () => {}  // placeholder (referenced from compose)
let submit = () => {}         // placeholder

let statusLbl = label("model server: connecting…")
let usageLbl = label("")
let tieLbl = label("")
let mcpLbl = label("")
let rightCol = container.NewVBox([usageLbl, tieLbl, mcpLbl])
let statusRow = container.NewBorder(nil, nil, nil, rightCol, statusLbl)

let modeBtn = widget.NewButton("", () => {
    if (mode == "plan") { agent.setMode("default") } else { agent.setMode("plan") }
})
let newBtn = widget.NewButton("+ new", () => { agent.newSession() })
let sessBtn = widget.NewButton("sessions", () => { toggleSessions() })
let harnessBtn = widget.NewButton("harness", () => { openHarness() })
let toolbar = container.NewHBox([modeBtn, newBtn, sessBtn, harnessBtn])
let header = container.NewBorder(nil, nil, nil, toolbar, statusRow)

let entry = widget.NewEntry()
entry.PlaceHolder = "describe a task — Enter to send"

let bottom = container.NewBorder(nil, nil, nil, container.NewHBox([
    widget.NewButton("send", () => { submit() }),
    widget.NewButton("stop", () => { agent.interrupt() }),
]), entry)

let compose = () => {
    let all = widgets
    if (tail != nil) {
        all = all + [tail]
    }
    let sc = container.NewScroll(container.NewVBox(all))
    let topParts = [header]
    if (permCards != []) {
        topParts = topParts + permRows(permCards, 0, [])
    }
    if (memCards != []) {
        topParts = topParts + memRows(memCards, 0, [])
    }
    if (skillCards != []) {
        topParts = topParts + skillRows(skillCards, 0, [])
    }
    let left = nil
    if (sessOpen) {
        left = container.NewVBox([widget.NewButton("« close", () => { toggleSessions() })] + sessBtns(sessList, 0, []))
    }
    let right = nil
    if (todos != []) {
        right = container.NewVBox([label("todos:")] + todoRows(todos, 0, []))
    }
    let center = sc
    if (viewMode == "harness") {
        if (harnessDirty) { buildHarness() }
        center = container.NewScroll(container.NewVBox(harnessRows))
    }
    window.SetContent(container.NewBorder(container.NewVBox(topParts), bottom, left, right, center))
    if (viewMode == "chat") {
        sc.ScrollToBottom()
    }
}

let addBlock = (w) => {
    widgets = widgets + [w]
    compose()
}

let ensureTail = () => {
    if (tail == nil) {
        tailBuf = ""
        tail = label("")
    }
}

// closeTail replaces the streaming tail (if any) with block w; nil drops it.
let closeTail = (w) => {
    if (tail != nil) {
        if (w != nil) {
            widgets = widgets + [w]
        }
        tail = nil
        tailBuf = ""
        compose()
    } else if (w != nil) {
        addBlock(w)
    }
}

toggleSessions = () => {
    if (sessOpen) {
        sessOpen = false
    } else {
        sessList = json.parse(agent.sessions())
        sessOpen = true
    }
    compose()
}

let skillListText = (arr, i, acc) => acc
skillListText = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let s = arr[i]
    return skillListText(arr, i + 1, acc + "\n- " + s.name + ": " + short(s.description, 60))
}

// ---------- harness panel (M15) ----------
openHarness = () => {
    viewMode = "harness"
    harnessDirty = true
    compose()
}
let closeHarness = () => {
    viewMode = "chat"
    compose()
}
let refreshHarness = () => {
    if (viewMode == "harness") { compose() }
}

let harnessFileRows = (files, i, acc) => acc
harnessFileRows = (files, i, acc) => {
    if (i >= len(files)) { return acc }
    let name = files[i]
    let got = agent.harnessGet(name)
    if (got.error != "") {
        return harnessFileRows(files, i + 1, acc + [label("⚠ " + name + ": " + got.error)])
    }
    let ed = widget.NewMultiLineEntry()
    ed.Text = got.content
    let row = container.NewVBox([
        label("— " + name + " —"),
        ed,
        container.NewHBox([widget.NewButton("save " + name, () => {
            let r = agent.harnessSave(name, ed.Text)
            if (r.error != "") {
                harnessMsg = "save " + name + " failed: " + r.error
            } else {
                harnessMsg = "saved " + name + " — prose applies next run; allow:/ask:/deny: rules need restart"
            }
            if (r.warns != []) { harnessMsg = harnessMsg + " | warn: " + r.warns[0] }
            harnessDirty = true
            refreshHarness()
        })])
    ])
    return harnessFileRows(files, i + 1, acc + [row])
}

let libRows = (arr, i, acc) => acc
libRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    let e = arr[i]
    let eid = e.id
    let plabel = "promote"
    if (pendingPromote == eid) { plabel = "promote — sure? click again" }
    let row = container.NewVBox([
        label(e.id + " — " + e.situation),
        container.NewHBox([
            widget.NewButton("experience", () => {
                if (openExp == eid) { openExp = "" } else { openExp = eid }
                harnessDirty = true
                refreshHarness()
            }),
            widget.NewButton(plabel, () => {
                if (pendingPromote == eid) {
                    let r = agent.libPromote(eid)
                    pendingPromote = ""
                    if (r.error != "") {
                        harnessMsg = "promote failed: " + r.error
                    } else {
                        harnessMsg = "promoted " + eid + " — backup: " + r.backup + " (restart to re-read rules)"
                    }
                } else {
                    pendingPromote = eid
                }
                harnessDirty = true
                refreshHarness()
            })
        ])
    ])
    return libRows(arr, i + 1, acc + [row])
}

let flagRows = (arr, i, acc) => acc
flagRows = (arr, i, acc) => {
    if (i >= len(arr)) { return acc }
    return flagRows(arr, i + 1, acc + [label("🪧 " + arr[i].gap)])
}

buildHarness = () => {
    let h = json.parse(agent.harnessInfo())
    let files = json.parse(agent.harnessFiles())
    let lb = json.parse(agent.harnessLibList())
    let en = ""
    if (h.enabled == false) { en = "  (DISABLED)" }
    let r = h.rules
    let cs = harnessCompText(h.components, 0, "")
    if (cs == "") { cs = " none (base harness)" }
    let rows = [
        label("harness — " + h.root + en),
        label("components:" + cs),
        label("guardrail rules: allow=" + sprintf("%d", len(r.allow)) + "  ask=" + sprintf("%d", len(r.ask)) + "  deny=" + sprintf("%d", len(r.deny))),
        label("prose edits apply next run; edit guardrails.md rule lines then RESTART fyagent")
    ]
    rows = rows + harnessFileRows(files, 0, [])
    if (h.warnings != []) {
        rows = rows + [label("⚠" + harnessWarnText(h.warnings, 0, ""))]
    }
    let lt = "none yet — evidence-backed improve steps create entries"
    if (lb != []) { lt = sprintf("%d entries — promoting is the only route into the global harness", len(lb)) }
    rows = rows + [label("improvement library: " + lt)]
    rows = rows + libRows(lb, 0, [])
    let fl = json.parse(agent.flagPeek(8))
    if (fl != []) {
        rows = rows + [label("reviewer flags (the next /improve consumes these as hints):")] + flagRows(fl, 0, [])
    }
    if (openExp != "") {
        let ex = json.parse(agent.libExperience(openExp))
        if (ex.error != "") {
            rows = rows + [label("⚠ experience: " + ex.error)]
        } else {
            rows = rows + [md("### experience — " + openExp + "\n\n" + ex.content)]
        }
    }
    if (harnessMsg != "") {
        rows = rows + [label(harnessMsg)]
    }
    harnessRows = [container.NewHBox([
        widget.NewButton("« back to chat", () => { closeHarness() }),
        widget.NewButton("improve last task", () => { agent.improveStart() })
    ])] + rows
    harnessDirty = false
}

let slash = (text) => {
    let cmd = strings.split(text, " ")[0]
    if (cmd == "/help") {
        addBlock(label("commands: /new /sessions /plan /build /skills /memory /index /journey /learn /improve /harness /quit  (shortcuts: Ctrl+N new, Ctrl+B sessions, Ctrl+D stop)"))
        return
    }
    if (cmd == "/new") { addBlock(label("⁘ new session")); agent.newSession(); return }
    if (cmd == "/sessions") { toggleSessions(); return }
    if (cmd == "/plan") { agent.setMode("plan"); return }
    if (cmd == "/build") { agent.setMode("default"); return }
    if (cmd == "/skills") {
        let ls = json.parse(agent.skillsList())
        if (ls == []) { addBlock(label("skills: none installed")) } else { addBlock(label("skills:" + skillListText(ls, 0, ""))) }
        return
    }
    if (cmd == "/memory") {
        let v = json.parse(agent.memoryView())
        addBlock(label("MEMORY.md (" + sprintf("%d/%d", len(v.memory), v.memory_cap) + "):\n" + v.memory))
        addBlock(label("USER.md (" + sprintf("%d/%d", len(v.user), v.user_cap) + "):\n" + v.user))
        return
    }
    if (cmd == "/index") { agent.rebuildIndex(); addBlock(label("⁘ session index rebuild requested")); return }
    if (cmd == "/learn") { agent.learnNow(); addBlock(label("🧠 learning pass queued (runs when idle)")); return }
    if (cmd == "/improve") { agent.improveStart(); addBlock(label("🔧 harness improvement started for the last task (propose → probe → compose)")); return }
    if (cmd == "/journey") {
        let js = json.parse(agent.journey(25))
        if (js == []) { addBlock(label("journey: empty")) } else { addBlock(label("journey (newest last):" + journeyText(js, 0, ""))) }
        return
    }
    if (cmd == "/harness") { openHarness(); return }
    if (cmd == "/quit") { agent.quit(); return }
    addBlock(label("unknown command " + cmd + " — try /help"))
}

submit = () => {
    let text = strings.trim(entry.Text, " \t\n")
    if (text == "") { return }
    entry.Text = ""
    if (strings.has_prefix(text, "/")) { slash(text); return }
    addBlock(md("> " + text))
    agent.send(text)
}

entry.OnSubmitted(() => { submit() })

// ---------- events ----------
let showHealth = (h) => {
    if (h.state == "online") {
        statusLbl.Text = sprintf("model: %s · ctx: %d", h.model, h.ctx_window)
    } else if (h.error != "") {
        statusLbl.Text = sprintf("model server: %s — %s", h.state, h.error)
    } else {
        statusLbl.Text = sprintf("model server: %s", h.state)
    }
}

let clearRun = () => {
    widgets = []
    tail = nil
    tailBuf = ""
    permCards = []
    todos = []
}

agent.on((evtJson) => {
    let evt = json.parse(evtJson)
    let t = evt.type

    if (t == "provider.state") {
        showHealth(evt.health)
        return
    }
    if (t == "mode.changed") {
        mode = evt.mode
        if (mode == "plan") { modeBtn.Text = "📋 plan" } else { modeBtn.Text = "🛠 build" }
        compose()
        return
    }
    if (t == "session.started") {
        clearRun()
        sessID = evt.id
        sessOpen = false
        window.SetStatus("session " + short(evt.id, 15))
        compose()
        return
    }
    if (t == "session.opened") {
        clearRun()
        sessID = evt.id
        sessOpen = false
        widgets = rebuild(evt.blocks, 0, [])
        window.SetStatus("session " + short(evt.id, 15))
        compose()
        return
    }
    if (t == "session.error") {
        addBlock(label("⚠ session " + evt.id + ": " + evt.error))
        return
    }
    if (t == "tie.state") {
        let s = evt.state
        if (!s.enabled) { tieLbl.Text = "" } else if (s.online) { tieLbl.Text = "index: " + s.collection } else { tieLbl.Text = "index: offline" }
        return
    }
    if (t == "mcp.state") {
        mcpLbl.Text = mcpText(evt.servers, 0, 0, 0)
    }
    if (t == "tie.rebuilt") {
        if (evt.error != "") {
            addBlock(label("⚠ index rebuild: " + evt.error))
        } else {
            addBlock(label("✔ index rebuilt: " + sprintf("%d sessions", evt.sessions)))
        }
        return
    }
    if (t == "compaction.done") {
        addBlock(label(sprintf("🗜 context compacted: %d → %d tokens (%d msgs)", evt.before, evt.after, evt.msgs)))
        return
    }
    if (t == "todo.updated") {
        todos = evt.items
        compose()
        return
    }
    if (t == "perm.request") {
        permCards = permCards + [evt]
        compose()
        return
    }
    if (t == "perm.resolved") {
        permCards = keepCards(permCards, 0, evt.id, [])
        compose()
        return
    }
    if (t == "memory.stage") {
        memCards = memCards + [evt.op]
        compose()
        return
    }
    if (t == "memory.resolved") {
        memCards = keepCards(memCards, 0, evt.id, [])
        if (evt.error != "") {
            addBlock(label("⚠ memory approval " + evt.id + ": " + evt.error))
        } else if (evt.approved) {
            addBlock(label("✔ memory saved: " + evt.target + " " + evt.action))
        } else {
            addBlock(label("✖ memory op rejected: " + evt.target + " " + evt.action))
        }
        compose()
        return
    }
    if (t == "skill.stage") {
        skillCards = skillCards + [evt.op]
        compose()
        return
    }
    if (t == "skill.applied") {
        addBlock(label("✔ skill " + evt.action + ": " + evt.name))
        return
    }
    if (t == "skill.resolved") {
        skillCards = keepCards(skillCards, 0, evt.id, [])
        if (evt.error != "") {
            addBlock(label("⚠ skill approval " + evt.id + ": " + evt.error))
        } else if (evt.approved) {
            addBlock(label("✔ skill " + evt.action + ": " + evt.name))
        } else {
            addBlock(label("✖ skill op rejected: " + evt.name))
        }
        compose()
        return
    }
    if (t == "review.start") {
        window.SetStatus("reviewing…")
        addBlock(label("🧠 background review started"))
        return
    }
    if (t == "review.skipped") {
        window.SetStatus("ready")
        if (evt.reason != "preempted by user") {
            addBlock(label("🧠 review skipped: " + evt.reason))
        }
        return
    }
    if (t == "review.flag") {
        addBlock(label("🪧 review flagged a harness gap for the improve loop: " + evt.gap))
        refreshHarness()
        return
    }
    if (t == "review.done") {
        window.SetStatus("ready")
        if (evt.error != "") {
            addBlock(label("⚠ background review: " + evt.error))
        } else if (len(evt.ledger) == 0) {
            addBlock(label("🧠 review: nothing worth saving"))
        } else {
            addBlock(label("🧠 review saved " + sprintf("%d", len(evt.ledger)) + " lessons:" + ledgerText(evt.ledger, 0, "")))
        }
        return
    }
    if (t == "improve.start") {
        window.SetStatus("improving harness…")
        addBlock(label("🔧 harness improvement started (run " + evt.run + ")"))
        return
    }
    if (t == "improve.propose") {
        addBlock(label("🔧 propose: " + evt.kind + " editor drafting…"))
        return
    }
    if (t == "improve.probe") {
        let extra = ""
        if (evt.error != "") { extra = " — " + evt.error }
        addBlock(label("🔧 probe " + evt.kind + ": " + sprintf("%d", evt.steps) + " steps in " + sprintf("%d", evt.duration_s) + "s" + extra))
        return
    }
    if (t == "improve.compose") {
        addBlock(label("🔧 composed successor, files changed: " + strings.join(evt.changed, ", ")))
        return
    }
    if (t == "improve.selector") {
        addBlock(label("🔧 selector: iter " + sprintf("%d", evt.chosen_iter) + " (" + evt.reason + ")"))
        return
    }
    if (t == "improve.budget") {
        addBlock(label("🔧 improve: budget reached at iter " + sprintf("%d", evt.iter)))
        return
    }
    if (t == "improve.done") {
        window.SetStatus("ready")
        if (evt.ok == false) {
            addBlock(label("⚠ improve: " + evt.error))
        } else if (evt.successor == false) {
            addBlock(label("🔧 improve: composer kept the current harness"))
        } else {
            addBlock(label("🔧 improve: successor applied to this session's overlay (global harness untouched)\n" + evt.decisions))
        }
        refreshHarness()
        return
    }
    if (t == "improve.error") {
        window.SetStatus("ready")
        addBlock(label("⚠ improve: " + evt.error))
        return
    }
    if (t == "run.started") {
        window.SetStatus("running…")
        usageLbl.Text = "running…"
        return
    }
    if (t == "run.busy") {
        window.SetStatus("a run is already active")
        return
    }
    if (t == "text.delta") {
        ensureTail()
        tailBuf = tailBuf + evt.text
        tail.Text = tailBuf
        return
    }
    if (t == "message.final") {
        closeTail(md(evt.text))
        return
    }
    if (t == "tool.start") {
        closeTail(label("🔧 " + evt.name + " " + strings.replace_all(evt.input, "\n", " ")))
        return
    }
    if (t == "tool.result") {
        let mark = "✔"
        if (evt.error) { mark = "✖" }
        addBlock(label("  " + mark + " " + evt.name + ": " + strings.replace_all(evt.preview, "\n", " ")))
        return
    }
    if (t == "run.finished") {
        closeTail(nil)
        if (evt.ok) {
            window.SetStatus("ready")
            let u = evt.usage
            usageLbl.Text = sprintf("in: %d · out: %d · ctx: %d%%", u.tin, u.tout, evt.ctx_pct)
        } else {
            window.SetStatus("error")
            usageLbl.Text = ""
            addBlock(label("⚠ " + evt.error))
        }
        return
    }
})

// ---------- boot ----------
showHealth(json.parse(agent.probe()))
memCards = json.parse(agent.memoryPending())
skillCards = json.parse(agent.skillPending())
window.AddShortcut("Ctrl+N", () => { agent.newSession() })
window.AddShortcut("Ctrl+B", () => { toggleSessions() })
window.AddShortcut("Ctrl+D", () => { agent.interrupt() })
compose()
window.Resize(980, 680)
window.SetStatus("fyagent")
print("BOOT-DONE")
